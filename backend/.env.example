# Copy this file to `.env` (gitignored) and fill in real values for local scripts.
# In production, set these same variables in the Back4App dashboard under
# Server Settings > Cloud Code / Environment Variables — `.env` is not used
# once deployed to Back4App.

# --- Back4App / Parse (from your app's dashboard: App Settings > Security & Keys) ---
PARSE_APP_ID=
PARSE_JS_KEY=
PARSE_MASTER_KEY=
PARSE_SERVER_URL=https://parseapi.back4app.com/

# --- OpenAI (server-side only — never shipped to the iOS client) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Apple App Store (subscription verification — see cloud/scrubPrep/appStoreVerifier.js) ---
# Must match the app's real bundle identifier exactly.
APPLE_BUNDLE_ID=dev.benderapps.ScrubPrep
# One of: Sandbox | Production | Xcode. Use Sandbox while testing with a sandbox tester
# Apple ID / TestFlight; switch to Production only once the app ships.
#
# "Xcode" is special and DANGEROUS if left on by mistake: transactions from Xcode's local
# StoreKit Configuration file (.storekit) are signed with a synthetic local key that can
# NEVER pass real cryptographic verification, by design (see appStoreVerifier.js). Setting
# this to "Xcode" makes the backend skip signature verification entirely for transactions
# whose own decoded payload also claims environment "Xcode", so local simulator/device
# testing can still exercise the full purchase -> paywall-dismisses loop. This must be set
# to "Sandbox" or "Production" on any deployment a real user or sandbox tester ever
# reaches — never leave a live/shared deployment set to "Xcode".
APPLE_APP_STORE_ENVIRONMENT=Sandbox
